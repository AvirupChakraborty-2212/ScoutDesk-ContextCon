# Crustdata
CRUSTDATA_API_KEY=your_crustdata_api_key_here

# LLM
LLM_PROVIDER=gemini          # anthropic | gemini | openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=                    # optional, default per provider
LLM_MAX_CONCURRENCY=4
LLM_FALLBACK_PROVIDER=        # optional second provider
LLM_FALLBACK_API_KEY=         # key for fallback provider

# Run settings
RUN_BUDGET_CREDITS=150
TOP_N=4
CACHE_DIR=.cache/crust
OFFLINE=0                     # 1 = serve only from cache (demo safety net)
